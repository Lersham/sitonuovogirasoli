---
// Icone originali a tratto singolo, disegnate per questo sito (non clip-art
// da libreria) — il "tocco illustrato" richiesto per ammorbidire la sezione
// servizi, restando nel linguaggio a filetto della direzione Cartella Unica.
interface Props {
  nome:
    | "valutazione"
    | "neuropsichiatria"
    | "riabilitazione"
    | "psicomotricita"
    | "tutoraggio"
    | "sostegno"
    | "parentTraining"
    | "equipe"
    | "inglese";
  class?: string;
}
const { nome, class: className } = Astro.props;
---

<svg class={className ?? "icona-servizio"} viewBox="0 0 40 40" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {nome === "valutazione" && (
    <>
      <rect x="9" y="7" width="22" height="27" rx="2.5" />
      <path d="M15 7c0-1.7 1.3-3 3-3h4c1.7 0 3 1.3 3 3" />
      <path d="M14 19l4 4 8-9" />
    </>
  )}
  {nome === "neuropsichiatria" && (
    <>
      <path d="M14 30v-4c-3-2-5-5.5-5-9 0-6.6 5.4-12 12-12s11 5 11 10.5c0 3-1.3 5-3 6.5v8" />
      <path d="M16 30h8" />
      <path d="M13 15l3 3 3-5 3 4 3-3" />
    </>
  )}
  {nome === "riabilitazione" && (
    <>
      <path d="M17 10h6a2 2 0 0 1 2 2v3.2a2 2 0 0 0 2 2H30a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-3.2a2 2 0 0 0-2 2V32a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-3.2a2 2 0 0 0-2-2H10a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h3.2a2 2 0 0 0 2-2V12a2 2 0 0 1 2-2Z" />
    </>
  )}
  {nome === "psicomotricita" && (
    <>
      <circle cx="22" cy="8" r="2.6" />
      <path d="M22 11v8l6 3M22 19l-5 3v8M17 22l-6-2" />
      <path d="M9 30q3-2 5-1" />
    </>
  )}
  {nome === "tutoraggio" && (
    <>
      <path d="M20 12c-2.4-1.7-6-2.5-11-2.5v19c5 0 8.6.8 11 2.5 2.4-1.7 6-2.5 11-2.5v-19c-5 0-8.6.8-11 2.5Z" />
      <path d="M20 12v19" />
      <path d="M27 8.5l3.2-1.3 1.3 3.2-3.2 1.3z" />
    </>
  )}
  {nome === "sostegno" && (
    <>
      <path d="M12 13h12a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-4l-4 4v-4h-1a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3Z" />
      <path d="M22 25h1a3 3 0 0 0 3-3v-4" />
    </>
  )}
  {nome === "parentTraining" && (
    <>
      <circle cx="15" cy="12" r="3.4" />
      <circle cx="27" cy="14.5" r="2.6" />
      <path d="M8 30v-2.5c0-3.5 3-6.3 7-6.3s7 2.8 7 6.3V30" />
      <path d="M23 30v-2c0-2.6 2-4.7 4.5-4.7s4.5 2.1 4.5 4.7v2" />
    </>
  )}
  {nome === "equipe" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <circle cx="28" cy="12" r="4" />
      <circle cx="20" cy="27" r="4" />
      <path d="M15 14.5l3 8M25 14.5l-3 8M15.7 10.7h8.6" />
    </>
  )}
  {nome === "inglese" && (
    <>
      <path d="M9 12h17a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H17l-5 4v-4a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3Z" />
      <path d="M14 17.5h12M14 20.5h8" />
    </>
  )}
</svg>

<style>
  .icona-servizio {
    width: 2.25rem;
    height: 2.25rem;
    stroke: var(--vermiglio);
    stroke-width: 1.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
</style>
